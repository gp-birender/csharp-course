    "version": "0.2.0",
    "configurations": [
        {
            "name": "CollectionsLinq",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build CollectionsLinq",
            "program": "${workspaceFolder}/CollectionsLinq/bin/Debug/net10.0/CollectionsLinq.dll",
            "cwd": "${workspaceFolder}/CollectionsLinq",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "WorkItemManager",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build WorkItemManager",
            "program": "${workspaceFolder}/WorkItemManager/bin/Debug/net10.0/WorkItemManager.dll",
            "cwd": "${workspaceFolder}/WorkItemManager",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}
